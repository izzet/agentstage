# AgentStage environment variables.
# Copy to .env and populate. The agentstage package + cli scripts read these.
# The PoC script at poc/probe_reasoning_slack.py auto-loads .env at the
# project root (see its load_env_file call).
#
# Never commit a populated .env — it's gitignored.

# ---------------------------------------------------------------------------
# LLM providers (campaign trio)
# ---------------------------------------------------------------------------

# Anthropic — Claude Haiku 4.5 via Azure Foundry (preferred; cluster credits).
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_ANTHROPIC_URL=https://<your-foundry-host>/anthropic/v1/messages

# Anthropic — direct API key fallback (rarely needed; prefer Azure path above).
ANTHROPIC_API_KEY=

# Google — Gemini 2.5 Flash via the direct generativelanguage API.
# Either name is accepted by the PoC code; pick one.
GOOGLE_GEMINI_API_KEY=
# GEMINI_API_KEY=

# OSS reasoning model served on NCSA Delta AI via SSH tunnel.
# vLLM launcher: scripts/delta/run_vllm_qwen3_thinking.sh (on Delta).
# Tunnel helper:  scripts/delta/tunnel.sh <gh-compute-host>     (on Ares).
OSS_MODEL_BASE_URL=http://localhost:8002/v1
OSS_MODEL_NAME=Qwen/Qwen3.6-27B

# Delta AI tunnel parameters (consumed by scripts/delta/tunnel.sh).
DELTA_LOGIN_HOST=gh-login01.delta.ncsa.illinois.edu
DELTA_USER=
# Set DELTA_COMPUTE_HOST to the gh<NNN> printed by the launcher banner; the
# tunnel script accepts it as $1 instead.
DELTA_COMPUTE_HOST=

# ---------------------------------------------------------------------------
# Providers NOT used in this campaign — kept for compatibility with the PoC
# script. Leave empty unless you're specifically running those code paths.
# ---------------------------------------------------------------------------

# OpenAI — Responses API (PoC code path exists but is blocked by quota/Azure deployment).
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESPONSES_URL=

# OpenRouter — DeepSeek-R1 path used in the PoC; replaced by self-hosted OSS for the campaign.
# OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Data roots
# ---------------------------------------------------------------------------

# Workload data root (NetCDF, BAM, GeoTIFF, FITS, etc.) for the curated
# AgentIOBench tasks.
AGENTIOBENCH_DATA_ROOT=/path/to/agentiobench/datasets

# Optional: adjacent AgentIOBench project root, read-only reference for
# empirical ground truth (io_report.json files from prior runs).
SCIIOBENCH_ROOT=

# External benchmark dataset locations (populated by scripts/fetch_datasets.sh).
SAB_DATA_ROOT=external/datasets/scienceagentbench
KRAMABENCH_DATA_ROOT=external/datasets/kramabench
