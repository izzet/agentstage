---
const bars = [
  { label: 'Haiku', value: 1.727, x: 112, color: '#315efb' },
  { label: 'Sonnet', value: 1.517, x: 232, color: '#7487d8' },
  { label: 'Flash', value: 1.826, x: 352, color: '#1c8b74' },
  { label: 'Qwen3', value: 1.877, x: 472, color: '#d89024' },
];
const y = (value: number) => 226 - ((value - 1) / 1.5) * 172;
---

<svg class="chart-svg" viewBox="0 0 620 286" role="img" aria-labelledby="speedup-chart-title speedup-chart-desc">
  <title id="speedup-chart-title">Mean curated-task speedup by reasoning model</title>
  <desc id="speedup-chart-desc">AgentStage speeds up curated tasks by 1.52 to 1.88 times on average across four reasoning models.</desc>
  <line x1="68" y1="54" x2="576" y2="54" class="chart-grid" />
  <line x1="68" y1="111" x2="576" y2="111" class="chart-grid" />
  <line x1="68" y1="169" x2="576" y2="169" class="chart-grid" />
  <line x1="68" y1="226" x2="576" y2="226" class="chart-axis" />
  <text x="53" y="59" text-anchor="end">2.5×</text>
  <text x="53" y="116" text-anchor="end">2.0×</text>
  <text x="53" y="174" text-anchor="end">1.5×</text>
  <text x="53" y="231" text-anchor="end">1.0×</text>
  <text x="68" y="25" class="chart-note">MEAN SESSION SPEEDUP · 3 CURATED TASKS</text>
  {bars.map((bar) => (
    <g>
      <rect x={bar.x} y={y(bar.value)} width="72" height={226 - y(bar.value)} rx="3" fill={bar.color} />
      <text x={bar.x + 36} y={y(bar.value) - 10} text-anchor="middle" class="chart-value">{bar.value.toFixed(2)}×</text>
      <text x={bar.x + 36} y="252" text-anchor="middle" class="chart-label">{bar.label}</text>
    </g>
  ))}
  <text x="322" y="278" text-anchor="middle" class="chart-note">REASONING MODEL</text>
</svg>
