---
const thinking = 29.55;
const baselineTool = 62.88;
const stagedTool = 22.09;
const scale = 4.55;
const thinkingWidth = thinking * scale;
const baselineToolWidth = baselineTool * scale;
const stagedToolWidth = stagedTool * scale;
const start = 134;
const detectionWidth = thinkingWidth * 0.32;
const stagingStart = start + detectionWidth + 18;
const stagingWidth = thinkingWidth * 0.50;
const naiveEnd = start + thinkingWidth + baselineToolWidth;
const stagedEnd = start + thinkingWidth + stagedToolWidth;
const hiddenTimeMidpoint = stagedEnd + (naiveEnd - stagedEnd) / 2;
---

<svg class="chart-svg" viewBox="0 0 620 390" role="img" aria-labelledby="timeline-chart-title timeline-chart-desc">
  <title id="timeline-chart-title">Session wall-time decomposition with and without AgentStage</title>
  <desc id="timeline-chart-desc">A representative curated session takes 92.43 seconds without AgentStage and 51.64 seconds with it. The 29.55 second thinking phase stays constant while tool time drops from 62.88 to 22.09 seconds. The control path is schematic: detection starts with thinking and dispatches staging before tool fire.</desc>
  <text x="86" y="26" class="chart-note">REPRESENTATIVE CURATED SESSION · WALL TIME</text>
  <line x1="134" y1="337" x2="570" y2="337" class="chart-axis" />
  <text x="134" y="356" text-anchor="middle">0 s</text>
  <text x="361.5" y="356" text-anchor="middle">50 s</text>
  <text x="552.5" y="356" text-anchor="middle">92 s</text>
  <text x="22" y="96" class="chart-label">Naive</text>
  <text x="22" y="170" class="chart-label">AgentStage</text>
  <rect x={start} y="65" width={thinkingWidth} height="48" rx="3" fill="#dfe5eb" />
  <rect x={start + thinkingWidth} y="65" width={baselineToolWidth} height="48" rx="3" fill="#315efb" />
  <rect x={start} y="141" width={thinkingWidth} height="48" rx="3" fill="#dfe5eb" />
  <rect x={start + thinkingWidth} y="141" width={stagedToolWidth} height="48" rx="3" fill="#315efb" />
  <text x={start + thinkingWidth / 2} y="86" text-anchor="middle" class="chart-segment">Thinking</text>
  <text x={start + thinkingWidth / 2} y="103" text-anchor="middle" class="chart-segment">29.55 s</text>
  <text x={start + thinkingWidth + baselineToolWidth / 2} y="86" text-anchor="middle" class="chart-segment chart-segment-light">Tool</text>
  <text x={start + thinkingWidth + baselineToolWidth / 2} y="103" text-anchor="middle" class="chart-segment chart-segment-light">62.88 s</text>
  <text x={start + thinkingWidth / 2} y="163" text-anchor="middle" class="chart-segment">Thinking</text>
  <text x={start + thinkingWidth / 2} y="180" text-anchor="middle" class="chart-segment">29.55 s</text>
  <text x={start + thinkingWidth + stagedToolWidth / 2} y="156" text-anchor="middle" class="chart-segment chart-segment-light">Tool</text>
  <text x={start + thinkingWidth + stagedToolWidth / 2} y="177" text-anchor="middle" class="chart-segment chart-segment-light">22.09 s</text>
  <text x={naiveEnd + 9} y="93" class="chart-value">92.43 s</text>
  <text x={stagedEnd + 9} y="169" class="chart-value">51.64 s</text>
  <rect x={stagingStart} y="211" width={stagingWidth} height="48" rx="3" fill="#1c8b74" />
  <text x={stagingStart + stagingWidth / 2} y="240" text-anchor="middle" class="chart-segment chart-segment-light">Staging</text>
  <rect x={start} y="265" width={detectionWidth} height="48" rx="3" fill="#7487d8" />
  <text x={start + detectionWidth / 2} y="294" text-anchor="middle" class="chart-segment chart-segment-light">Detection</text>
  <path d={`M${start + detectionWidth} 265 L${stagingStart} 259`} fill="none" stroke="#5b6cb5" stroke-width="1.5" stroke-dasharray="3 3" />
  <path d={`M${stagingStart - 7} 254 l7 5 -9 1`} fill="none" stroke="#5b6cb5" stroke-width="1.5" />
  <path d={`M${stagedEnd} 124 v-10 h${naiveEnd - stagedEnd} v10`} fill="none" stroke="#1c8b74" stroke-width="1.5" />
  <text x={hiddenTimeMidpoint} y="137" text-anchor="middle" class="chart-staging">40.79 s of tool-path time saved</text>
</svg>
