---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  socialImage?: string;
}

const { title, description, canonicalUrl, socialImage } = Astro.props;
const assetUrl = (filename: string) => new URL(filename, Astro.url).pathname;
const faviconUrl = assetUrl('favicon.svg');
const faviconPngUrl = assetUrl('favicon-32.png');
const faviconIcoUrl = assetUrl('favicon.ico');
const appleTouchIconUrl = assetUrl('apple-touch-icon.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="xOAsL7kCK8dOoM2HfkWJWEI5kKUsRb97HRnRJ6P45cw" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/x-icon" href={faviconIcoUrl} sizes="any" />
    <link rel="icon" type="image/png" href={faviconPngUrl} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="apple-touch-icon" href={appleTouchIconUrl} sizes="180x180" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AgentStage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
