# Working trees kept locally, never committed
paper/
poc/

# Campaign run outputs (regenerated from the package + LLM calls)
outputs/*
!outputs/.gitkeep

# Experiment driver outputs (E4 microbench, plotting scratch, etc.)
results/

# External dataset cache (fetched via scripts/fetch_datasets.sh)
external/datasets/*
!external/datasets/.gitkeep

# IOR source tree (cloned on demand by scripts/build_ior.sh)
external/libs/ior/

# uv / Python build artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets
.env
.env.local
